# =============================================================================
# Variables para Railway (Service → Variables)
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production

# Railway inyecta PORT automáticamente; no hace falta definirlo.

# MongoDB (usa el plugin MongoDB de Railway o Atlas)
MongoDB__ConnectionString=mongodb://user:pass@host:27017/?authSource=admin
MongoDB__DatabaseName=stocksip_platform

# CORS: URL pública de tu frontend en Vercel (sin barra final)
# Varias URLs separadas por coma si tienes preview + producción
FRONTEND_URL=https://tu-app.vercel.app,https://tu-app-git-main.vercel.app

# JWT (mínimo 32 caracteres; si es más corto, el API lo ajusta automáticamente)
Jwt__Secret=FrutiLogicProductionJwtSecretKey2026!Minimum32Chars
Jwt__Issuer=https://tu-app.vercel.app
Jwt__Audience=frutilogic-platform-api
Jwt__ValidateIssuer=true
Jwt__ValidateAudience=true

# Opcional — Google OAuth
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Mercado Pago (Checkout Pro — Perú / modo prueba)
# Access Token: en Mercado Pago → Tu integración → Credenciales de prueba → Access Token
MercadoPagoSettings__AccessToken=
MercadoPagoSettings__PublicKey=APP_USR-03744d5a-f2fa-4373-b22b-9b20fae5cc6a
MercadoPagoSettings__WebhookSecret=
MercadoPagoSettings__BackendPublicUrl=https://frutilogic-platform-api-production.up.railway.app
MercadoPagoSettings__FrontendPublicUrl=https://frutilogic-frontend.vercel.app
MercadoPagoSettings__UseSandbox=true

# Webhook en panel Mercado Pago (Modo de prueba):
# URL: https://frutilogic-platform-api-production.up.railway.app/api/v1/subscriptions
# Eventos: Pagos (payment)

# Opcional — SMTP (recuperación de contraseña)
SmtpServiceSettings__Server=smtp.gmail.com
SmtpServiceSettings__Port=587
SmtpServiceSettings__SenderName=FrutiLogic
SmtpServiceSettings__SenderEmail=
SmtpServiceSettings__Username=
SmtpServiceSettings__Password=
SmtpServiceSettings__UseSsl=true

# Opcional — Cloudinary (imágenes)
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=
