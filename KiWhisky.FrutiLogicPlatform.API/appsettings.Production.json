{
  "EnableSwaggerInProduction": true,
  "MongoDB": {
    "DatabaseName": "stocksip_platform"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://stocksip-front-end-application.vercel.app",
      "https://frutilogic-frontend.vercel.app"
    ]
  },
  "Jwt": {
    "Secret": "FrutiLogicProductionJwtSecretKey2026!",
    "Issuer": "frutilogic-platform-api",
    "Audience": "frutilogic-platform-api",
    "ExpiryMinutes": 1440,
    "ClockSkew": 5,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "RequireExpirationTime": true,
    "RequireSignedTokens": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
